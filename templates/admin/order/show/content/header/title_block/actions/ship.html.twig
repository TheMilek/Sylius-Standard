{% set order = hookable_metadata.context.resource %}
{{ dump(order) }}

{#{% if sylius_sm_can(order.shipment, constant('Sylius\\Component\\Shipping\\ShipmentTransitions::GRAPH'), constant('Sylius\\Component\\Shipping\\ShipmentTransitions::TRANSITION_SHIP')) %}#}
    <form action="{{ path('sylius_admin_order_shipment_ship', {'id': order.shipment.id, 'orderId': order.id}) }}" method="POST" novalidate>
        <input type="hidden" name="_method" value="PUT">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token(order.id) }}" />
        <button type="submit" class="dropdown-item">
            {{ ux_icon('tabler:truck', {'class': 'icon dropdown-item-icon'}) }}
            {{ 'sylius.ui.ship'|trans }}
        </button>
    </form>
{#{% endif %}#}
